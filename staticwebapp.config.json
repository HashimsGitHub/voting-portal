{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/admin/*",
      "allowedRoles": ["admin", "authenticated"]
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "auth": {
    "identityProviders": {
      "customOpenIdConnectProviders": {}
    }
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/login",
      "statusCode": 200
    },
    "403": {
      "rewrite": "/unauthorized",
      "statusCode": 200
    },
    "404": {
      "rewrite": "/",
      "statusCode": 200
    }
  },
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": ["/api/*", "/*.{svg,png,jpg,gif,ico,css,js}"]
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
