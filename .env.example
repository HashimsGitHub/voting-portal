# MongoDB Atlas connection string
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/voting?appName=<AppName>

# JWT signing secret (generate a strong random string, e.g. `openssl rand -base64 32`)
JWT_SECRET=<generate-a-strong-random-string>

# Frontend API base URL (used by the React app)
REACT_APP_API_URL=http://localhost:7071/api

# Admin email for initial setup - registering/logging in with this email grants the admin role
ADMIN_EMAIL=admin@nustalumni.org

# Password used by scripts/seed_admin.py to create the initial admin account
ADMIN_PASSWORD=<set-a-strong-password>
